<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A0E1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver Registration"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Application Progress"
                android:textSize="13sp"
                android:textColor="#94A3B8"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 1"
                android:textSize="13sp"
                android:textColor="#94A3B8"/>
        </LinearLayout>

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#2563EB"
            android:progressBackgroundTint="#1E293B"
            android:layout_marginBottom="24dp"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professional Profile"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please provide your details to set up your driver profile."
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="24dp"/>

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textSize="13sp"
            android:textColor="#C8D1DC"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/profile_input_bg_dark"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="e.g. Johnathan Smith"
            android:textColor="#E8ECF0"
            android:textColorHint="#4A5568"
            android:textSize="14sp"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

        <!-- Age -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Age"
            android:textSize="13sp"
            android:textColor="#C8D1DC"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/profile_input_bg_dark"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="e.g. 35"
            android:textColor="#E8ECF0"
            android:textColorHint="#4A5568"
            android:textSize="14sp"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <!-- Weight & Height Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight (kg)"
                    android:textSize="13sp"
                    android:textColor="#C8D1DC"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etWeight"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/profile_input_bg_dark"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="e.g. 80"
                    android:textColor="#E8ECF0"
                    android:textColorHint="#4A5568"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Height (cm)"
                    android:textSize="13sp"
                    android:textColor="#C8D1DC"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etHeight"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/profile_input_bg_dark"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="e.g. 175"
                    android:textColor="#E8ECF0"
                    android:textColorHint="#4A5568"
                    android:textSize="14sp"
                    android:inputType="numberDecimal"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Resting Heart Rate -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resting Heart Rate (BPM)"
            android:textSize="13sp"
            android:textColor="#C8D1DC"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etRestingHR"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/profile_input_bg_dark"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="e.g. 70 (leave blank if unknown)"
            android:textColor="#E8ECF0"
            android:textColorHint="#4A5568"
            android:textSize="14sp"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <!-- Emergency Contact -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Contact"
            android:textSize="13sp"
            android:textColor="#C8D1DC"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/etEmergencyContact"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/profile_input_bg_dark"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Phone Number"
            android:textColor="#E8ECF0"
            android:textColorHint="#4A5568"
            android:textSize="14sp"
            android:inputType="phone"
            android:layout_marginBottom="32dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Complete Registration  →"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Skip -->
        <Button
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Skip for Now"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Terms -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="By continuing, you agree to our Terms of Service and Driver Policy."
            android:textSize="11sp"
            android:textColor="#64748B"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
